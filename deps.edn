;; sha256d -- portable .cljc SHA-256 / Bitcoin SHA-256d reference implementation,
;; plus an interchangeable "gene pool" of proven-equivalent round-primitive
;; formulations and a self-contained evolutionary benchmark tournament over them.
;; Zero third-party deps for the core; JVM Clojure + ClojureScript both run the same
;; .cljc source (see README.md "Portability").
{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PORTABILITY PROOF: compile the CPU-only .cljc core to JS and run it on node,
  ;; mirroring com-junkawasaki/num-clj's cljs-verify pattern.
  ;;   clojure -M:cljs && node target/cljs-verify.js
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
         :main-opts ["-m" "cljs.main"
                     "-co" "{:optimizations :simple :target :nodejs :main sha256d.cljs-verify :output-to \"target/cljs-verify.js\"}"
                     "-c" "sha256d.cljs-verify"]}
  ;; the co-scientist/AlphaEvolve-shaped tournament over sha256d.ops' gene pool.
  ;;   clojure -M:evolve >> docs/evolution-log.md
  :evolve {:main-opts ["-m" "sha256d.evolve"]}
  ;; run the SAME tournament under ClojureScript/node — tests whether the JVM speed
  ;; conclusions hold on V8 (round 8).  clojure -M:cljs-bench && node target/cljs-bench.js
  :cljs-bench {:extra-paths ["test"]
               :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
               :main-opts ["-m" "cljs.main"
                           "-co" "{:optimizations :simple :target :nodejs :main sha256d.cljs-bench :output-to \"target/cljs-bench.js\"}"
                           "-c" "sha256d.cljs-bench"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :kotoba {:replace-deps {io.github.kotoba-lang/compiler
                          {:git/url "https://github.com/kotoba-lang/compiler.git"
                           :git/sha "78f43e64125e9c4bbe2bfb3a9520ae4b767dc275"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
